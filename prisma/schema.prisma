generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model User { id String @id @default(cuid()); name String?; email String @unique; emailVerified DateTime?; image String?; password String?; createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); accounts Account[]; sessions Session[]; studySessions StudySession[]; quizResults QuizResult[]; goals Goal[]; reminders Reminder[]; userProgress UserProgress?; userPreferences UserPreferences?; @@map("users") }
model Account { id String @id @default(cuid()); userId String @map("user_id"); type String; provider String; providerAccountId String @map("provider_account_id"); refresh_token String?; access_token String?; expires_at Int?; token_type String?; scope String?; id_token String?; session_state String?; user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@unique([provider, providerAccountId]); @@map("accounts") }
model Session { id String @id @default(cuid()); sessionToken String @unique @map("session_token"); userId String @map("user_id"); expires DateTime; user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@map("sessions") }
model VerificationToken { identifier String; token String @unique; expires DateTime; @@unique([identifier, token]); @@map("verification_tokens") }
model StudySession { id String @id @default(cuid()); userId String @map("user_id"); subject String; chapter String?; topic String?; startTime DateTime @map("start_time"); endTime DateTime? @map("end_time"); duration Int?; completed Boolean @default(false); notes String?; createdAt DateTime @default(now()) @map("created_at"); user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@index([userId, subject]); @@index([userId, startTime]); @@map("study_sessions") }
model QuizResult { id String @id @default(cuid()); userId String @map("user_id"); subject String; chapter String?; topic String?; score Int; totalQuestions Int @map("total_questions"); correctAnswers Int @map("correct_answers"); mistakes Json?; weakTopics Json? @map("weak_topics"); duration Int?; takenAt DateTime @default(now()) @map("taken_at"); createdAt DateTime @default(now()) @map("created_at"); user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@index([userId, subject]); @@index([userId, takenAt]); @@map("quiz_results") }
model Goal { id String @id @default(cuid()); userId String @map("user_id"); title String; description String?; type String; target Float?; current Float @default(0); unit String?; deadline DateTime?; priority String @default("medium"); status String @default("active"); createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@index([userId, status]); @@map("goals") }
model Reminder { id String @id @default(cuid()); userId String @map("user_id"); title String; description String?; type String; scheduledAt DateTime @map("scheduled_at"); isRecurring Boolean @default(false) @map("is_recurring"); recurrenceRule String? @map("recurrence_rule"); completed Boolean @default(false); createdAt DateTime @default(now()) @map("created_at"); user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@index([userId, scheduledAt]); @@map("reminders") }
model UserProgress { id String @id @default(cuid()); userId String @unique @map("user_id"); totalStudyHours Float @default(0) @map("total_study_hours"); totalSessions Int @default(0) @map("total_sessions"); totalQuizzes Int @default(0) @map("total_quizzes"); averageQuizScore Float @default(0) @map("average_quiz_score"); studyStreak Int @default(0) @map("study_streak"); longestStreak Int @default(0) @map("longest_streak"); lastStudyDate DateTime? @map("last_study_date"); subjectProgress Json @default("{}") @map("subject_progress"); dailyTracking Json @default("{}") @map("daily_tracking"); weeklySummaries Json @default("[]") @map("weekly_summaries"); createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@map("user_progress") }
model UserPreferences { id String @id @default(cuid()); userId String @unique @map("user_id"); dailyStudyTarget Int @default(4) @map("daily_study_target"); preferredSubjects Json @default("[]") @map("preferred_subjects"); examBoard String @default("CBSE") @map("exam_board"); academicYear String @default("2025-2026") @map("academic_year"); voiceEnabled Boolean @default(true) @map("voice_enabled"); voiceSpeed Float @default(1.0) @map("voice_speed"); theme String @default("dark"); fontSize String @default("medium"); aiMode String @default("study"); aiTemperature Float @default(0.7) @map("ai_temperature"); createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@map("user_preferences") }
model ChatMessage { id String @id @default(cuid()); userId String @map("user_id"); role String; content String; mode String @default("study"); metadata Json?; createdAt DateTime @default(now()) @map("created_at"); user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@index([userId, createdAt]); @@map("chat_messages") }
model SyllabusProgress { id String @id @default(cuid()); userId String @map("user_id"); subject String; chapter String; topics Json @default("[]"); completed Boolean @default(false); confidence Int @default(0); notes String?; startedAt DateTime? @map("started_at"); completedAt DateTime? @map("completed_at"); createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@unique([userId, subject, chapter]); @@index([userId, subject]); @@map("syllabus_progress") }
